@model CVGS.Models.OrderViewModel

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h3>Order Confirmation</h3>
        </div>
        <div class="card-body">
            <h5>Thank you for your order!</h5>
            <p>Your order number is: <strong>@Model.OrderedDetails.First().OrderId</strong></p>

            <hr />
            <h5>Customer Details</h5>
            <p>
                <strong>Name:</strong> @ViewBag.UserDetails.Name<br />
                <strong>Address:</strong> @ViewBag.UserDetails.Address<br />
                <strong>Phone:</strong> @ViewBag.UserDetails.Phone<br />
            </p>

            <hr />
            <h5>Order Summary</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Game</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderedDetails)
                    {
                        <tr>
                            <td>@item.Game.Title</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@(item.Quantity * item.Price).ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <hr />
            <div class="text-end">
                <p><strong>Subtotal:</strong> @Model.Subtotal.ToString("C")</p>
                <p><strong>Tax (@Model.TaxRate:P):</strong> @Model.TaxAmount.ToString("C")</p>
                <p><strong>Total:</strong> @Model.TotalPrice.ToString("C")</p>
            </div>
        </div>
    </div>
</div>
