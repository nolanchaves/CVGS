@model CVGS.Models.ReviewRateViewModel
@{
    ViewData["Title"] = "Add Review";
}

<h1>Review</h1>

<form asp-action="AddReview" method="post">
    <input asp-for="GameId" value="@Model.GameId" type="hidden" />

    <div class="form-group">
        <label asp-for="Rate"></label>
        <input asp-for="Rate" class="form-control" type="number"/>
    </div>
    <div class="form-group">
        <label asp-for="Review"></label>
        <input asp-for="Review" class="form-control" type="text"/>
    </div>

    <br />



    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Add Review</button>
    </div>
</form>

