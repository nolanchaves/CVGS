@model IEnumerable<GameViewModel>
@{
    ViewData["Title"] = "Game List";
}

<h1 class="text-center">Game List</h1>

<!-- Search -->
<div class="container mb-4">
    <form asp-action="AllGames" method="get" class="d-flex justify-content-center">
        <input type="text" name="searchQuery" class="form-control w-50" placeholder="Search games by title" value="@ViewBag.SearchQuery" />
        <button type="submit" class="btn btn-primary ms-2">Search</button>
        <a asp-controller="Games" asp-action="AllGames" class="btn btn-warning">Refresh</a>
    </form>
</div>

<!-- Game List -->
<div class="container">
    <div class="row">
        @foreach (var game in Model)
        {
            <div class="col-md-2 mb-4">
                <div class="card" style="height: 100%;">
                    <br />
                    <a asp-controller="Games" asp-action="GameDetails" asp-route-id="@game.GameID">
                        <img src="@game.CoverImageURL" class="card-img-top" alt="@game.Title" style="height: 200px; width: 100%; object-fit: contain;" />
                    </a>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-center">@game.Title</h5>
                        <p class="card-text text-center"><strong>Platform:</strong> @game.Platform</p>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-center mt-2">
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    <input type="hidden" name="gameId" value="@game.GameID" />
                                    <button type="submit" class="btn btn-success me-2">Add to Cart</button>
                                </form>
                            </div>
                            <div class="d-flex justify-content-center mt-2">
                                <a asp-controller="Wishlist" asp-action="AddWishlist" asp-route-id="@game.GameID" class="btn btn-primary">Add to Wishlist</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
