@model GameViewModel
@{
    ViewData["Title"] = @Model.Title;
}

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.CoverImageURL" class="img-fluid" alt="@Model.Title" style="height: 700px; width: 100%; object-fit: contain;" />
        </div>

        <div class="col-md-6">
            <h1 class="text-center">@Model.Title</h1>
            <p><strong>Description:</strong> @Model.Description</p>
            <p><strong>Platform:</strong> @Model.Platform</p>
            <p><strong>Category:</strong> @Model.Category</p>
            <p><strong>Language Support:</strong> @Model.LanguageSupport</p>
            <p><strong>Price:</strong> @Model.Price.ToString("C")</p>
            <p><strong>Rating:</strong> @Model.Rating</p>
            <p><strong>Download Size:</strong> @(Model.DownloadSize / (1024 * 1024)) MB</p>

            <div class="d-flex justify-content-start mt-2">
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="gameId" value="@Model.GameID" />
                    <button type="submit" class="btn btn-success me-2">Add to Cart</button>
                </form>
            </div>
            <div class="d-flex justify-content-start mt-2">
                <a asp-controller="Wishlist" asp-action="AddWishlist" asp-route-id="@Model.GameID" class="btn btn-primary">Add to Wishlist</a>
            </div>
            <div class="d-flex justify-content-start mt-2">
                <a asp-controller="Games" asp-action="AllGames" class="btn btn-danger">Back to All Games</a>
            </div>
        </div>
    </div>
</div>
<div class="container mt-5">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Reviews</h2>
            <div class="d-flex ms-auto">
                <a asp-controller="Review" asp-action="AddReview" asp-route-id="@Model.GameID" class="btn btn-outline-success">Add Review</a>
            </div>
        </div>

        <div class="card-body">

            <!-- User's Review -->
            @if (Model.UserReview != null)
            {
                <div class="card mb-2">
                    <div class="card-header">
                        <h5>@Model.UserReview.DisplayName</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text"><strong>Rate:</strong> @Model.UserReview.Rating</p>
                        <p class="card-text">@Model.UserReview.ReviewContent</p>
                    </div>
                </div>
            }

            <!-- All Reviews -->
            @if (Model.Reviews != null)
            {
                @foreach (var review in Model.Reviews)
                {
                    <div class="card mb-2">
                        <div class="card-header">
                            <h5>@review.DisplayName</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text"><strong>Rate:</strong> @review.Rating</p>
                            <p class="card-text">@review.ReviewContent</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>


