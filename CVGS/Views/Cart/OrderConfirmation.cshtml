@model CVGS.Entities.Order

<div class="container mt-4">
    <!-- Order Confirmation Card -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h2 class="card-title mb-0">Order Confirmation</h2>
        </div>
        <div class="card-body">
            <p class="mb-2">Thank you for your order!</p>
            <p><strong>Order Number:</strong> @Model.OrderId</p>
            <p><strong>Order Date:</strong> @Model.OrderDate.ToString("g")</p>
            <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>
        </div>
    </div>

    <!-- Order Details Card -->
    <div class="card">
        <div class="card-header bg-secondary text-white">
            <h3 class="card-title mb-0">Order Details</h3>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Game</th>
                        <th>Game Type</th>
                        <th>Quantity</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <tr>
                            <td>@detail.Game.Title</td>
                            <td>@detail.GameType</td>
                            <td>@detail.Quantity</td>
                            <td>@detail.Price.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="text-end mt-3">
                <p><strong>Total Tax:</strong> @Model.TaxAmount.ToString("C")</p>
                <p><strong>Total Price:</strong> @Model.TotalPrice.ToString("C")</p>
            </div>
        </div>
    </div>
</div>
