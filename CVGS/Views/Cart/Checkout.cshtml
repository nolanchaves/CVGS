@model CVGS.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header text-center">
            <h2>Checkout</h2>
        </div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>There were some errors with your checkout:</strong>
                    <ul>
                        @foreach (var entry in ViewData.ModelState)
                        {
                            foreach (var error in entry.Value.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }
            <form asp-controller="Cart" asp-action="PlaceOrder" method="post">

                <input type="hidden" asp-for="CartItems" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="PaymentMethod" />
                <input type="hidden" asp-for="TotalBeforeTax" />
                <input type="hidden" asp-for="TaxAmount" />
                <input type="hidden" asp-for="TotalPrice" />
                <input type="hidden" asp-for="TaxRate" />


                <div class="mb-4">
                    <label for="CreditCardNumber" class="form-label">Credit Card Number</label>
                    <input asp-for="CreditCardNumber" type="text" class="form-control" id="CreditCardNumber" placeholder="1234 5678 9012 3456">
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label for="ExpiryDate" class="form-label">Expiry Date (MM/YY)</label>
                        <input asp-for="ExpiryDate" type="text" class="form-control" id="ExpiryDate" placeholder="MM/YY">
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="CVV" class="form-label">CVV</label>
                        <input asp-for="CVV" type="text" class="form-control" id="CVV" placeholder="123">
                    </div>
                </div>

                <h3 class="mt-4">Order Summary</h3>
                <div class="card p-3 mb-4">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Game Title</th>
                                <th>Quantity</th>
                                <th>Game Type</th>
                                <th>Price Per Game</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <td>@item.Game.Title</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.GameType</td>
                                    <td>@item.Game.Price.ToString("C")</td>
                                    <td>@((item.Quantity * item.Game.Price).ToString("C"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card p-4">
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <p><strong>Subtotal:</strong> @Model.TotalBeforeTax.ToString("C")</p>
                            <p><strong>Tax (@(Model.TaxRate * 100)%):</strong> @Model.TaxAmount.ToString("C")</p>
                        </div>
                        <div class="col-12 col-md-6">
                            <h4><strong>Total: @Model.TotalPrice.ToString("C")</strong></h4>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Cart" asp-action="ViewCart" class="btn btn-outline-danger ms-2 w-auto">Back to Cart</a>
                    <button type="submit" class="btn btn-primary me-2 w-auto">Place Order</button>
                </div>
            </form>
        </div>
    </div>
</div>