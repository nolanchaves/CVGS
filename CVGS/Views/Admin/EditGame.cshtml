@model CVGS.Models.GameViewModel

@{
    ViewData["Title"] = "Edit Game";
}

<div class="card">
    <div class="card-header">
        <h1>Edit Game</h1>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>There were some errors:</strong>
            <ul>
                @foreach (var entry in ViewData.ModelState)
                {
                    foreach (var error in entry.Value.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }

    <div class="card-body">
        <form asp-action="EditGame" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="GameID" />

            <div class="form-group mb-3">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Platform"></label>
                <input asp-for="Platform" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category"></label>
                <input asp-for="Category" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="LanguageSupport"></label>
                <input asp-for="LanguageSupport" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="DownloadSize"></label>
                <input asp-for="DownloadSize" class="form-control" type="number" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
            </div>

            <div class="form-group mb-3">
                <label for="CoverImage">Upload New Cover Image (optional)</label>
                <input type="file" asp-for="CoverImage" class="form-control" accept="image/*" />
            </div>

            <div class="form-group mb-3">
                @if (!string.IsNullOrEmpty(Model.CoverImageURL))
                {
                    <img src="@Model.CoverImageURL" alt="Current Cover Image" style="max-width: 200px;" />
                }
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-controller="Admin" asp-action="DeleteEditGames" class="btn btn-danger">Return to Game List</a>
        </form>
    </div>
</div>
