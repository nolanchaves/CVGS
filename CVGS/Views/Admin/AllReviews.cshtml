@model IEnumerable<CVGS.Entities.Review>

@{
    ViewData["Title"] = "All Reviews";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">All Reviews</h2>
            <a asp-controller="Admin" asp-action="Panel" class="btn btn-danger ms-auto">Return to Panel</a>
        </div>

        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Game</th>
                        <th>User</th>
                        <th>Content</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Model)
                    {
                        <tr>
                            <td>@review.Game?.Title</td>
                            <td>@review.User?.UserName</td>
                            <td>@review.Content</td>
                            <td>@review.Rating</td>
                            <td>
                                @(review.Approved ? "Approved" : "Unapproved")
                            </td>
                            <td>
                                <form asp-action="DeleteReview" asp-route-id="@review.Id" method="post">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
