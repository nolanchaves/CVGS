@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="card mt-4">
    <div class="card-header">
        <h2 class="card-title">Admin Panel</h2>
    </div>

    <!--Reports-->
    <div class="card-body mb-2">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title text-center">Reports</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <a asp-controller="Admin" asp-action="AllGames" class="btn btn-primary w-100">Game List</a>
                    </div>
                    <div class="col-md-4 mb-2">
                        <a asp-controller="Admin" asp-action="AllUsers" class="btn btn-primary w-100">Member List</a>
                    </div>
                    <div class="col-md-4 mb-2">
                        <a asp-controller="Admin" asp-action="AllUsersWithWishlist" class="btn btn-primary w-100">Members WishLists</a>
                    </div>
                    <div class="col-md-4 mb-2">
                        <a href="#" class="btn btn-primary w-100">Sales Report</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row mb-3">
            <!--Games-->
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title text-center">Manage Games</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 mb-2">
                                <a asp-controller="Admin" asp-action="AddGame" class="btn btn-success w-100">Add New Games</a>
                            </div>
                            <div class="col-12 mb-2">
                                <a asp-controller="Admin" asp-action="DeleteEditGames" class="btn btn-danger w-100">Edit or Remove Games</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--Events-->
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title text-center">Manage Events</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 mb-2">
                                <a asp-controller="Admin" asp-action="AddEvent" class="btn btn-success w-100">Add Event</a>
                            </div>
                            <div class="col-12 mb-2">
                                <a asp-controller="Admin" asp-action="AllEvents" class="btn btn-danger w-100">Edit or Remove Event</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--Reviews-->
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title text-center">Manage Reviews</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 mb-2">
                                <a asp-controller="Admin" asp-action="UnapprovedReviews" class="btn btn-warning w-100">Unapproved Reviews</a>
                            </div>
                            <div class="col-12 mb-2">
                                <a asp-controller="Admin" asp-action="AllReviews" class="btn btn-primary w-100">All Reviews</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
