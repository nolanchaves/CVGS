@model IEnumerable<CVGS.Entities.Event>

@{
    ViewData["Title"] = "All Events";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">All Events</h2>
            <a asp-controller="Admin" asp-action="Panel" class="btn btn-danger ms-auto">Return to Panel</a>
        </div>

        <div class="container mt-5">
            <div class="row">
                @foreach (var eventItem in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100"> <!-- Ensure the card stretches vertically -->
                            <div class="card-header">
                                <h5 class="card-title">@eventItem.Name</h5>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="card-text"><strong>Description:</strong> @eventItem.Description</p>
                                <p class="card-text"><strong>Date:</strong> @eventItem.Date.ToString("yyyy-MM-dd")</p>
                                <p class="card-text"><strong>Location:</strong> @eventItem.Location</p>
                                <p class="card-text"><strong>Max Registrations:</strong> @eventItem.MaxRegistrations</p>
                                <!-- Add empty space to make the cards the same height -->
                                <div class="mt-auto"></div>
                            </div>
                            <div class="card-footer">
                                <div class="d-flex justify-content-between">
                                    <form asp-action="EditEvent" asp-route-id="@eventItem.EventId" method="get" class="w-100 me-2 mb-2">
                                        <button type="submit" class="btn btn-primary btn-sm w-100">Edit</button>
                                    </form>
                                    <form asp-action="DeleteEvent" asp-route-id="@eventItem.EventId" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');" class="w-100 mb-2">
                                        <button type="submit" class="btn btn-danger btn-sm w-100">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
