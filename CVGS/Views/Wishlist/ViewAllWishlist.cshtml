@model IEnumerable<GameViewModel>
@{
    ViewData["Title"] = "Wisht List";
}

<h1 class="text-center">Your Wishlist</h1>

<div class="container">
    <div class="row">
        @foreach (var game in Model)
        {
            <div class="col-md-2 mb-4">
                <div class="card" style="height: 100%;">
                    <br />
                    <a asp-controller="Games" asp-action="GameDetails" asp-route-id="@game.GameID">
                        <img src="@game.CoverImageURL" class="card-img-top" alt="@game.Title" style="height: 200px; width: 100%; object-fit: contain;" />
                    </a>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-center">@game.Title</h5>
                        <p class="card-text text-center"><strong>Platform:</strong> @game.Platform</p>
                        <div class="d-flex justify-content-center mt-auto">
                            <button class="btn btn-success">Add to Cart</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>